DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tiktok_intelligence?schema=public"
REDIS_URL="redis://localhost:6379"
DISABLE_WORKERS="false"
# Keep false on the company computer when it uses managed PostgreSQL/Redis.
# Set true only when deliberately using localhost or Docker service hostnames.
ALLOW_LOCAL_SERVICES="true"
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3000"
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
TIKTOK_RESEARCH_CLIENT_KEY=""
TIKTOK_RESEARCH_CLIENT_SECRET=""
# Optional server-only key. An Ultra-capable key exposes the exact TikTok LIVE
# Creator League (D5-C1-A1-S) from the creator's Gift Gallery, including offline accounts.
TIKTOOL_API_KEY=""
# Optional signed fallback for pay_grade.level / webcast_anchor_level.level
# (the numeric account level shown inside LIVE, e.g. 23).
TIKHUB_API_KEY=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"
S3_ENDPOINT=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET=""
# Paymob Egypt hosted checkout. Keep all secrets server-only.
PAYMOB_BASE_URL="https://accept.paymob.com"
PAYMOB_SECRET_KEY=""
PAYMOB_PUBLIC_KEY=""
PAYMOB_HMAC_SECRET=""
PAYMOB_CARD_INTEGRATION_ID=""
PAYMOB_WALLET_INTEGRATION_ID=""
# Plans are priced in USD. Set the reviewed conversion rate used for EGP checkout.
PAYMENT_USD_TO_EGP_RATE=""
# Optional manual fallback. Configure in the hosting environment, never in source code.
MANUAL_PAYMENT_ACCOUNT_LABEL="InstaPay / Mobile wallet"
MANUAL_PAYMENT_ACCOUNT_NUMBER=""
