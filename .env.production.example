# ─── TikTok Intelligence Platform — Production Environment ──
# Copy this file to .env.production and fill in the values

# ─── Database ──────────────────────────────────────────────
# Inside Docker, use the db service name, not localhost or the Neon endpoint.
# Use the POSTGRES_PASSWORD below here too (URL-encode special characters).
DATABASE_URL="postgresql://postgres:your-secure-postgres-password@db:5432/tiktok_intelligence?schema=public"

# ─── Redis ─────────────────────────────────────────────────
REDIS_PASSWORD="your-secure-redis-password"
REDIS_URL="redis://default:your-secure-redis-password@redis:6379"

# ─── Authentication ────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 32
BETTER_AUTH_SECRET="your-secure-random-secret-here"

# ─── OAuth (Optional) ─────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

# ─── Application URL ──────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://your-domain.com"
BETTER_AUTH_URL="https://your-domain.com"

# ─── S3-Compatible Storage (Optional) ─────────────────────
S3_ENDPOINT=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET=""

# ─── Payment Provider (Optional) ──────────────────────────
PAYMENT_PROVIDER_SECRET_KEY=""

# ─── PostgreSQL Configuration ─────────────────────────────
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your-secure-postgres-password"
POSTGRES_DB="tiktok_intelligence"

# ─── Security Notes ───────────────────────────────────────
# 1. Keep this file secure and never commit it to version control
# 2. Use strong, unique passwords for all services
# 3. Enable HTTPS in production (HSTS recommended)
# 4. Set proper file permissions: chmod 600 .env.production
