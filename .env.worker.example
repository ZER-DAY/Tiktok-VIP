# Copy this file to .env.worker on the always-on company computer.
# Use the exact same managed service URLs configured in Vercel.
DATABASE_URL="postgresql://USER:PASSWORD@MANAGED-POSTGRES-HOST:5432/DATABASE?sslmode=require"
REDIS_URL="rediss://default:PASSWORD@MANAGED-REDIS-HOST:6379"
BETTER_AUTH_SECRET="replace-with-the-same-32+-character-secret-used-on-vercel"
NEXT_PUBLIC_APP_URL="https://YOUR-PROJECT.vercel.app"

DISABLE_WORKERS="false"
ALLOW_LOCAL_SERVICES="false"

TIKTOK_RESEARCH_CLIENT_KEY=""
TIKTOK_RESEARCH_CLIENT_SECRET=""
TIKTOOL_API_KEY=""
TIKHUB_API_KEY=""
