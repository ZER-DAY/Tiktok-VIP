FROM node:22-alpine AS base

ENV HUSKY=0
RUN corepack enable && corepack prepare pnpm@11.20.0 --activate

# The project does not emit a `dist/` directory. The worker runs the two
# BullMQ consumers directly through tsx, so it uses the same source and
# path aliases as development and CI.
FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 worker

COPY package.json pnpm-lock.yaml tsconfig.json ./
RUN pnpm install --frozen-lockfile --ignore-scripts

COPY prisma ./prisma
COPY src ./src

RUN pnpm exec prisma generate
RUN chown -R worker:nodejs /app

USER worker

# DATABASE_URL and REDIS_URL are supplied at runtime. Migrations are run by
# the deploy step before the worker starts; this keeps the long-lived process
# free from schema migration races when multiple workers are deployed.
HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
  CMD ["./node_modules/.bin/tsx", "src/workers/healthcheck.ts"]

CMD ["./node_modules/.bin/tsx", "src/workers/index.ts"]
