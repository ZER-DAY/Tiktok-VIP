[Unit]
Description=TikTok Intelligence Platform - Worker
After=network.target docker.service tiktok-web.service
Requires=docker.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/tiktok-platform
ExecStart=/usr/bin/docker compose -f docker-compose.prod.yml up worker
ExecStop=/usr/bin/docker compose -f docker-compose.prod.yml stop worker
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
